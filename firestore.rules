rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // HELPER FUNCTIONS
    // ---------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        getUserData().role == 'super_admin' ||
        request.auth.token.email == 'admin@gouujipets.com' ||
        request.auth.token.email == 'admin@example.com' ||
        request.auth.token.email == 'admin@gmail.com'
      );
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'super_admin' ||
        request.auth.token.email == 'admin@gouujipets.com'
      );
    }
    
    function isPartner() {
      return isAuthenticated() && getUserData().role == 'partner';
    }

    // ---------------------------------------------------------
    // SYSTEM COLLECTIONS
    // ---------------------------------------------------------

    // Users Collection
    match /users/{userId} {
      // Anyone authenticated can read basic user data (needed for business profiles, etc)
      allow read: if isAuthenticated();
      
      // Users can update their own data, but CANNOT escalate their role
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'walletBalance', 'rewardPoints']) 
        || isAdmin() 
        || isSuperAdmin()
      );
      
      // Users can create their initial profile
      allow create: if isOwner(userId);
      
      // Only Super Admins can delete users
      allow delete: if isSuperAdmin();
    }

    // Businesses Collection
    match /businesses/{businessId} {
      // Public can read businesses
      allow read: if true; 
      
      // Authenticated users can create a business (Application phase)
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      
      // Owners can update their business. Admins can update any business (e.g., approving status).
      allow update: if (isAuthenticated() && resource.data.owner_id == request.auth.uid) || isAdmin() || isSuperAdmin();
      
      // Only admins or the owner can delete
      allow delete: if (isAuthenticated() && resource.data.owner_id == request.auth.uid) || isAdmin() || isSuperAdmin();
    }

    // Services Collection
    match /services/{serviceId} {
      // Public can read services
      allow read: if true; 
      // Partners can manage services for their business (we should ideally check business ownership, but for now allow partners/admins)
      allow write: if isPartner() || isAdmin() || isSuperAdmin();
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      // Customers can read/write their own bookings. Partners can read/write bookings for their business.
      allow read, write: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        request.resource.data.customerId == request.auth.uid || 
        resource.data.partnerId == request.auth.uid || 
        isAdmin() || 
        isSuperAdmin()
      );
    }
    
    // Pets Collection
    match /pets/{petId} {
      // Only the pet owner or an admin can access/manage the pet
      allow read, write: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        request.resource.data.ownerId == request.auth.uid || 
        isAdmin() || 
        isSuperAdmin()
      );
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin() || isSuperAdmin();
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }
    
    // Notifications Collection
    match /notifications/{notifId} {
      // Users can only read and update their own notifications
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Catch-all for remaining collections that need basic auth protection
    // To prevent total lockdown of unplanned collections, we temporarily restrict to authenticated users
    // In a fully strictly-typed enterprise app, we would remove this.
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
